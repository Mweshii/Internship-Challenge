# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is listed in .gitignore, so your real passwords never reach GitHub.

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- MySQL ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=techfix

# --- Admin login ----------------------------------------------------------
# A long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# `npm run db:setup` creates this admin account (the password is stored hashed).
# Use at least 10 characters.
ADMIN_NAME=Shop Owner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Shop settings --------------------------------------------------------
# SAMPLE VALUE: 50 is only an example. Set the real delivery fee in N$ (0 = free).
DELIVERY_FEE=50
# Set either to false if the business does not offer that option.
DELIVERY_ENABLED=true
COLLECTION_ENABLED=true
